# Measurement output. Stays on disk; deliberately out of git — 32 MB of
# scope traces per session, and .h5/.dat blobs do not diff usefully.
# Two sets of measurements ARE tracked, because a claim with no evidence beside
# it gets rediscovered: bench-archive/ (the numerical regression) and
# acceptance/ (the 2026-09-02 LabVIEW-vs-service pair and that day's journals).
runs/
bench-reports/

# Scratch exports left by the plotting steps
.tr.json
.tr_export_tmp.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
