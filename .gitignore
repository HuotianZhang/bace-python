# Measurement output. Stays on disk; deliberately out of git — 32 MB of
# scope traces per session, and .h5/.dat blobs do not diff usefully.
# Two sets of measurements ARE tracked, because a claim with no evidence beside
# it gets rediscovered: bench-archive/ (the numerical regression) and
# acceptance/ (the 2026-09-02 LabVIEW-vs-service pair and that day's journals).
runs/
bench-reports/

# Scratch exports left by the plotting steps
.tr.json
.tr_export_tmp.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environments
.venv/

# `.github/workflows/tests.yml` installs eslint into the repo root so
# `tests/test_ui.py` can find it (`npx --no-install`); anyone reproducing the
# CI locally gets one too. There is no package.json here on purpose — the
# console has no build step.
node_modules/
package-lock.json
venv/
env/

# Editors and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
